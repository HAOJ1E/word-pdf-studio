<Window x:Class="WordPdfStudio.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="文页 PDF · 离线文档工具" Width="1220" Height="820" MinWidth="1060" MinHeight="720" WindowStartupLocation="CenterScreen" AllowDrop="True" Drop="WindowDrop" DragOver="WindowDragOver" Closing="WindowClosing">
 <Grid x:Name="RootGrid">
  <Grid.ColumnDefinitions><ColumnDefinition Width="210"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
  <Border Background="White" BorderBrush="#E7EAF3" BorderThickness="0,0,1,0">
   <Grid Margin="20,28,20,22"><Grid.RowDefinitions><RowDefinition Height="84"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel><StackPanel Orientation="Horizontal"><Border Background="#6855E8" Width="36" Height="36" CornerRadius="10" Margin="0,0,10,0"><TextBlock Text="文" Foreground="White" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><StackPanel VerticalAlignment="Center"><TextBlock Text="文页 PDF" FontSize="19" FontWeight="Bold"/><TextBlock Text="让文档流转更简单" FontSize="10" Foreground="{StaticResource Muted}"/></StackPanel></StackPanel></StackPanel>
    <StackPanel Grid.Row="1"><TextBlock Text="工作空间" Foreground="#9CA5B8" FontSize="10" Margin="12,0,0,14"/>
     <Button x:Name="NavConvert" Tag="convert" Content="▣    Word 转 PDF" Click="NavClick" HorizontalContentAlignment="Left" Margin="0,0,0,8" Padding="15,14"/>
     <Button x:Name="NavTools" Tag="tools" Content="▦    PDF 工具箱" Click="NavClick" HorizontalContentAlignment="Left" Margin="0,0,0,8" Padding="15,14"/>
     <Button x:Name="NavHistory" Tag="history" Content="◷    处理记录" Click="NavClick" HorizontalContentAlignment="Left" Margin="0,0,0,8" Padding="15,14"/>
     <Button x:Name="NavAbout" Tag="about" Content="ⓘ    使用指南" Click="NavClick" HorizontalContentAlignment="Left" Margin="0,0,0,8" Padding="15,14"/>
    </StackPanel>
    <Border Grid.Row="2" Background="#F5F4FE" CornerRadius="10" Padding="14"><StackPanel><TextBlock Text="●  离线处理 · 文件留在本机" Foreground="#5F54C4" FontSize="10" FontWeight="SemiBold"/><TextBlock Text="无需安装 Office&#10;Windows 10 / 11 · 64 位" Foreground="#8E88B3" FontSize="10" LineHeight="19" Margin="0,8,0,0"/></StackPanel></Border>
   </Grid>
  </Border>
  <Grid Grid.Column="1" Margin="28,25,28,22"><Grid.RowDefinitions><RowDefinition Height="62"/><RowDefinition Height="*"/><RowDefinition Height="32"/></Grid.RowDefinitions>
   <Grid><StackPanel><TextBlock x:Name="PageTitle" Text="Word 转 PDF" FontSize="25" FontWeight="Bold"/><TextBlock x:Name="PageSubtitle" Text="从一份文档，到一整个文件夹，轻松完成转换。" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,7,0,0"/></StackPanel><Border HorizontalAlignment="Right" VerticalAlignment="Top" Background="#E9F6F1" CornerRadius="14" Padding="12,7"><TextBlock Text="●  本地离线" Foreground="#348D76" FontSize="11"/></Border></Grid>
   <Grid x:Name="ConvertPanel" Grid.Row="1"><Grid.RowDefinitions><RowDefinition Height="96"/><RowDefinition Height="74"/><RowDefinition Height="*"/><RowDefinition Height="150"/></Grid.RowDefinitions>
    <Border Background="#EEEAFE" CornerRadius="12" Margin="0,0,0,14"><Grid Margin="22,14"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="126"/></Grid.ColumnDefinitions><StackPanel VerticalAlignment="Center"><TextBlock Text="把文档，变成好用的 PDF。" FontSize="20" FontWeight="SemiBold" Foreground="#423681"/><TextBlock Text="保留文字、图片与表格，支持 DOC / DOCX / RTF / ODT" Foreground="#8B80B3" FontSize="11" Margin="0,9,0,0"/></StackPanel><Grid Grid.Column="1"><Border Width="40" Height="48" CornerRadius="5" Background="White" HorizontalAlignment="Left" VerticalAlignment="Center"><TextBlock Text="W" FontSize="22" Foreground="#637ACC" FontWeight="Bold" VerticalAlignment="Center" HorizontalAlignment="Center"/></Border><TextBlock Text="→" Foreground="#A097CA" FontSize="22" HorizontalAlignment="Center" VerticalAlignment="Center"/><Border Width="40" Height="48" CornerRadius="5" Background="#6855E8" HorizontalAlignment="Right" VerticalAlignment="Center"><TextBlock Text="PDF" FontSize="12" Foreground="White" FontWeight="Bold" VerticalAlignment="Center" HorizontalAlignment="Center"/></Border></Grid></Grid></Border>
    <UniformGrid Grid.Row="1" Columns="3" Margin="0,0,0,14"><Border Style="{StaticResource Card}" Margin="0,0,10,0" Padding="16,10"><StackPanel Orientation="Horizontal"><TextBlock x:Name="QueuedCount" Text="0" FontSize="23" FontWeight="Bold"/><TextBlock Text="  等待转换" Foreground="{StaticResource Muted}" VerticalAlignment="Center" FontSize="11"/></StackPanel></Border><Border Style="{StaticResource Card}" Margin="0,0,10,0" Padding="16,10"><StackPanel Orientation="Horizontal"><TextBlock x:Name="DoneCount" Text="0" FontSize="23" FontWeight="Bold" Foreground="#348D76"/><TextBlock Text="  已完成" Foreground="{StaticResource Muted}" VerticalAlignment="Center" FontSize="11"/></StackPanel></Border><Border Style="{StaticResource Card}" Padding="16,10"><StackPanel Orientation="Horizontal"><TextBlock x:Name="ErrorCount" Text="0" FontSize="23" FontWeight="Bold" Foreground="#C25464"/><TextBlock Text="  需重试" Foreground="{StaticResource Muted}" VerticalAlignment="Center" FontSize="11"/></StackPanel></Border></UniformGrid>
    <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="14"/><ColumnDefinition Width="260"/></Grid.ColumnDefinitions>
     <Border Style="{StaticResource Card}"><Grid><Grid.RowDefinitions><RowDefinition Height="56"/><RowDefinition Height="*"/><RowDefinition Height="48"/></Grid.RowDefinitions>
      <Grid Margin="14,10"><TextBlock Text="转换队列" FontWeight="SemiBold" VerticalAlignment="Center"/><StackPanel x:Name="QueueAddActions" Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="+ 添加文件" Padding="12,7" Click="AddFilesClick" Margin="0,0,6,0"/><Button Content="文件夹" Padding="12,7" Click="AddFolderClick"/></StackPanel></Grid>
      <DataGrid x:Name="QueueGrid" Grid.Row="1" SelectionChanged="QueueSelectionChanged" MouseDoubleClick="QueueDoubleClick"><DataGrid.Columns><DataGridTemplateColumn Header="文档" Width="*" CanUserSort="False"><DataGridTemplateColumn.CellTemplate><DataTemplate><StackPanel><TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" ToolTip="{Binding SourcePath}"/><TextBlock Text="{Binding Type}" FontSize="9" Foreground="#9AA4B9" Margin="0,4,0,0"/></StackPanel></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn><DataGridTextColumn Header="大小" Binding="{Binding Size}" Width="72" CanUserSort="False"/><DataGridTemplateColumn Header="状态" Width="94" CanUserSort="False"><DataGridTemplateColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding Status}" Foreground="{Binding StatusColor}" FontSize="11" ToolTip="{Binding Detail}"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn></DataGrid.Columns></DataGrid>
      <StackPanel x:Name="EmptyHint" Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center" IsHitTestVisible="False" Margin="18"><TextBlock Text="↓" FontSize="35" Foreground="#B6ABF1" HorizontalAlignment="Center"/><TextBlock Text="拖入文档，开始转换" FontSize="15" Foreground="#68748D" HorizontalAlignment="Center" Margin="0,9,0,0"/><TextBlock Text="也可添加整个文件夹（含子文件夹）" FontSize="10" Foreground="#A0A8BA" Margin="0,9,0,0" HorizontalAlignment="Center"/></StackPanel>
      <StackPanel x:Name="QueueEditActions" Grid.Row="2" Orientation="Horizontal" Margin="12,7"><Button Content="移除" Click="RemoveClick" Padding="10,6" Margin="0,0,5,0"/><Button Content="↑" ToolTip="上移所选文档" Click="MoveUpClick" Padding="10,6" Margin="0,0,5,0"/><Button Content="↓" ToolTip="下移所选文档" Click="MoveDownClick" Padding="10,6" Margin="0,0,5,0"/><Button Content="清理已完成" Click="ClearDoneClick" Padding="10,6"/></StackPanel>
     </Grid></Border>
     <Border Grid.Column="2" Style="{StaticResource Card}" Padding="17"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel x:Name="ConversionSettings"><TextBlock Text="转换设置" FontWeight="SemiBold" Margin="0,0,0,18"/><TextBlock Text="图片质量" Style="{StaticResource Label}"/><ComboBox x:Name="QualityBox" SelectedIndex="0"><ComboBoxItem Content="高质量 · 适合打印"/><ComboBoxItem Content="均衡 · 日常分享"/><ComboBoxItem Content="小文件 · 邮件传输"/></ComboBox><TextBlock Text="页面范围（留空转换全部）" Style="{StaticResource Label}" Margin="0,18,0,8"/><TextBox x:Name="ConvertRangeBox" ToolTip="例如 1-3,5；该范围应用于每份文档"/><CheckBox x:Name="PdfACheck" Content="PDF/A-2b 归档格式" Checked="PdfACheckChanged" Unchecked="PdfACheckChanged" Margin="0,17,0,8"/><CheckBox x:Name="MergeCheck" Content="转换后按队列顺序合并"/><TextBlock Text="归档模式关闭合并；合并会生成额外文件，单份 PDF 仍保留。" FontSize="10" Foreground="#9AA4B9" Margin="0,8,0,0"/></StackPanel></ScrollViewer></Border>
    </Grid>
    <Border Grid.Row="3" Style="{StaticResource Card}" Margin="0,14,0,0" Padding="17,12"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><Grid x:Name="OutputSettings"><Grid.ColumnDefinitions><ColumnDefinition Width="64"/><ColumnDefinition/><ColumnDefinition Width="86"/></Grid.ColumnDefinitions><TextBlock Text="输出目录" VerticalAlignment="Center" FontSize="11"/><TextBox x:Name="OutputFolderBox" Grid.Column="1" Padding="10,6" ToolTip="可直接输入目录；不存在时自动创建"/><Button Grid.Column="2" Content="选择…" Click="ChooseOutputClick" Padding="10,6" Margin="8,0,0,0"/></Grid><StackPanel x:Name="OutputFlags" Grid.Row="1" Orientation="Horizontal"><CheckBox x:Name="SourceFolderCheck" Content="保存到原文件所在目录" Margin="0,7,24,7" Checked="SourceFolderChanged" Unchecked="SourceFolderChanged"/><CheckBox x:Name="OpenAfterCheck" Content="完成后打开目录" IsChecked="True" Margin="0,7,0,7"/></StackPanel><Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="90"/><ColumnDefinition Width="146"/></Grid.ColumnDefinitions><StackPanel VerticalAlignment="Center" Margin="0,0,16,0"><TextBlock x:Name="BatchStatus" Text="准备就绪 · 同名文件自动编号" FontSize="10" Foreground="{StaticResource Muted}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/><ProgressBar x:Name="BatchProgress" Height="4" Maximum="100" Value="0" Foreground="#6855E8" Background="#EEF0F6" BorderThickness="0" Margin="0,8,0,0"/></StackPanel><Button x:Name="CancelButton" Grid.Column="1" Content="取消" Click="CancelClick" IsEnabled="False" Padding="15,8" Margin="0,0,8,0"/><Button x:Name="StartButton" Grid.Column="2" Content="开始转换  →" Click="StartConversionClick" Style="{StaticResource Primary}" Padding="15,8"/></Grid></Grid></Border>
   </Grid>
   <Grid x:Name="ToolsPanel" Grid.Row="1" Visibility="Collapsed"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <UniformGrid x:Name="ToolChoices" Columns="4" Rows="2" Margin="0,0,0,14"><Button Tag="merge" Content="▤  合并 PDF" Click="ToolClick" Margin="0,0,8,8"/><Button Tag="extract" Content="▣  提取页面" Click="ToolClick" Margin="0,0,8,8"/><Button Tag="split" Content="▥  逐页拆分" Click="ToolClick" Margin="0,0,8,8"/><Button Tag="watermark" Content="◈  添加水印" Click="ToolClick" Margin="0,0,0,8"/><Button Tag="encrypt" Content="◇  密码保护" Click="ToolClick" Margin="0,0,8,0"/><Button Tag="rotate" Content="↻  旋转页面" Click="ToolClick" Margin="0,0,8,0"/><Button Tag="images" Content="▧  图片转 PDF" Click="ToolClick" Margin="0,0,8,0"/><Border Background="#EEEAFE" CornerRadius="8" Padding="14"><TextBlock Text="一站式整理 PDF" Foreground="#8B80B3" FontSize="11" VerticalAlignment="Center" HorizontalAlignment="Center"/></Border></UniformGrid>
    <Border Grid.Row="1" Style="{StaticResource Card}" Padding="20"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="24"/><ColumnDefinition Width="270"/></Grid.ColumnDefinitions><Grid><Grid.RowDefinitions><RowDefinition Height="66"/><RowDefinition Height="*"/><RowDefinition Height="48"/></Grid.RowDefinitions><StackPanel><TextBlock x:Name="ToolTitle" Text="合并 PDF" FontSize="18" FontWeight="SemiBold"/><TextBlock x:Name="ToolHint" Text="添加两份或更多 PDF，按列表顺序拼接。" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,8,0,0"/></StackPanel><ListBox x:Name="ToolFilesList" Grid.Row="1" BorderBrush="#E5E9F2" Background="#FAFBFD" AllowDrop="True" Padding="6"><ListBox.ItemTemplate><DataTemplate><StackPanel Margin="8,9"><TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/><TextBlock Text="{Binding SourcePath}" FontSize="10" Foreground="#9AA4B9" Margin="0,5,0,0" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/></StackPanel></DataTemplate></ListBox.ItemTemplate></ListBox><StackPanel x:Name="ToolFileActions" Grid.Row="2" Orientation="Horizontal" VerticalAlignment="Bottom"><Button Content="+ 添加" Click="AddToolFilesClick" Padding="12,8" Margin="0,0,6,0"/><Button Content="移除" Click="RemoveToolFileClick" Padding="12,8" Margin="0,0,6,0"/><Button Content="↑" Click="MoveToolUpClick" Padding="12,8" Margin="0,0,6,0"/><Button Content="↓" Click="MoveToolDownClick" Padding="12,8"/><Button Content="清空" Click="ClearToolFilesClick" Padding="12,8" Margin="6,0,0,0"/></StackPanel></Grid><ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto"><StackPanel x:Name="ToolOptions"><TextBlock Text="操作选项" FontWeight="SemiBold" Margin="0,0,0,18"/><StackPanel x:Name="RangeOption" Visibility="Collapsed"><TextBlock Text="提取页码，例如 3,1-2" Style="{StaticResource Label}"/><TextBox x:Name="ToolRangeBox" Text="1" Margin="0,0,0,18"/></StackPanel><StackPanel x:Name="WatermarkOption" Visibility="Collapsed"><TextBlock Text="水印文字（最多 60 字）" Style="{StaticResource Label}"/><TextBox x:Name="WatermarkBox" Text="内部资料" MaxLength="60" Margin="0,0,0,18"/></StackPanel><StackPanel x:Name="PasswordOption" Visibility="Collapsed"><TextBlock Text="设置打开密码" Style="{StaticResource Label}"/><PasswordBox x:Name="NewPasswordBox" MaxLength="127" Margin="0,0,0,10"/><TextBlock Text="再次输入密码" Style="{StaticResource Label}"/><PasswordBox x:Name="ConfirmPasswordBox" MaxLength="127" Margin="0,0,0,18"/></StackPanel><StackPanel x:Name="RotateOption" Visibility="Collapsed"><TextBlock Text="顺时针旋转所有页面" Style="{StaticResource Label}"/><ComboBox x:Name="RotationBox" SelectedIndex="0" Margin="0,0,0,18"><ComboBoxItem Content="90°"/><ComboBoxItem Content="180°"/><ComboBoxItem Content="270°"/></ComboBox></StackPanel><StackPanel x:Name="InputPasswordOption"><TextBlock Text="原文件密码（受保护时填写）" Style="{StaticResource Label}"/><PasswordBox x:Name="InputPasswordBox" Margin="0,0,0,18"/><TextBlock Text="合并时此密码用于列表中的所有 PDF。" Foreground="#9AA4B9" FontSize="10"/></StackPanel><Border Background="#F5F4FE" CornerRadius="8" Padding="13" Margin="0,20,0,0"><TextBlock x:Name="ToolNote" Text="生成新文件，原文件保留。除密码保护功能外，新文件不保留原打开密码；书签、交互表单和数字签名可能不保留。" FontSize="10" Foreground="#8C84B0" LineHeight="19"/></Border></StackPanel></ScrollViewer></Grid></Border>
    <Border Grid.Row="2" Style="{StaticResource Card}" Margin="0,14,0,0" Padding="20,15"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="156"/></Grid.ColumnDefinitions><TextBlock x:Name="ToolStatus" Text="添加文件后，点击右侧按钮选择保存位置。" FontSize="11" Foreground="{StaticResource Muted}" VerticalAlignment="Center" Margin="0,0,15,0"/><Button x:Name="RunToolButton" Grid.Column="1" Content="开始处理  →" Click="RunToolClick" Style="{StaticResource Primary}"/></Grid></Border>
   </Grid>
   <Grid x:Name="HistoryPanel" Grid.Row="1" Visibility="Collapsed"><Grid.RowDefinitions><RowDefinition Height="54"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Grid><TextBlock Text="最近 200 条本机记录" Foreground="{StaticResource Muted}" VerticalAlignment="Center"/><Button Content="清空记录" Click="ClearHistoryClick" HorizontalAlignment="Right"/></Grid><Border Grid.Row="1" Style="{StaticResource Card}" ClipToBounds="True"><DataGrid x:Name="HistoryGrid" MouseDoubleClick="HistoryDoubleClick"><DataGrid.Columns><DataGridTextColumn Header="时间" Binding="{Binding TimeLabel}" Width="100"/><DataGridTextColumn Header="操作" Binding="{Binding Action}" Width="105"/><DataGridTextColumn Header="文件" Binding="{Binding FileName}" Width="*"/><DataGridTextColumn Header="结果" Binding="{Binding Status}" Width="70"/></DataGrid.Columns></DataGrid></Border><StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,14,0,0"><Button Content="打开结果" Click="OpenHistoryClick" Margin="0,0,8,0"/><Button Content="查看详情" Click="HistoryDetailClick"/><TextBlock Text="  双击打开结果 · 清空记录不会删除文件" Foreground="{StaticResource Muted}" FontSize="10" VerticalAlignment="Center"/></StackPanel></Grid>
   <Border x:Name="AboutPanel" Grid.Row="1" Visibility="Collapsed" Style="{StaticResource Card}" Padding="28"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel><TextBlock Text="文页 PDF  1.0" FontSize="24" FontWeight="Bold"/><TextBlock Text="一份 EXE，随时处理文档。" Foreground="#8B80B3" Margin="0,8,0,24"/><TextBlock Text="快速开始" FontSize="16" FontWeight="SemiBold"/><TextBlock Text="1. 添加或拖入 Word 文档，也可以添加整个文件夹。&#10;2. 选择输出目录、图片质量及页面范围。&#10;3. 点击开始转换，完成后双击队列打开 PDF。&#10;4. 使用 PDF 工具箱继续合并、拆分、加水印或设置密码。" LineHeight="27" Margin="0,12,0,24"/><TextBlock Text="运行与隐私" FontSize="16" FontWeight="SemiBold"/><TextBlock Text="支持 Windows 10 22H2 / Windows 11 的 64 位电脑；不需要 Office、WPS、Java 或额外的 .NET。全程在本地转换，无联网请求、上传与账号登录。首次转换会把内置引擎解压到当前用户的本地应用数据目录，建议预留 2 GB 空间；无需管理员权限。设置与处理记录保存在本机，密码不会保存。" LineHeight="25" Margin="0,12,0,24"/><TextBlock Text="版式与文件说明" FontSize="16" FontWeight="SemiBold"/><TextBlock Text="转换使用 LibreOffice 26.2.6。缺少原文档字体、复杂域、嵌入对象或特殊排版时，结果可能与 Word 有差异，重要文件请检查。受密码保护的 Word 文档应先在原编辑软件中解除保护。宏不会执行。PDF/A 与页面范围应用于每份文档；工具箱生成派生 PDF，交互表单、目录书签和数字签名可能不保留。" LineHeight="25" Margin="0,12,0,24"/><TextBlock Text="开源组件" FontSize="16" FontWeight="SemiBold"/><TextBlock Text="LibreOffice（MPL 2.0 及其第三方许可证）、PDFsharp（MIT）、.NET（MIT）和 Microsoft Visual C++ 运行库。完整许可文件随内置引擎分发。" LineHeight="25" Margin="0,12,0,14"/><Button Content="查看本机数据目录" Click="OpenDataClick" HorizontalAlignment="Left"/><TextBlock Text="本软件未做代码签名。首次启动如 Windows 提示未知发布者，可核对交付包中的 SHA-256 校验值。" Foreground="#9AA4B9" FontSize="11" Margin="0,24,0,0"/></StackPanel></ScrollViewer></Border>
   <Grid Grid.Row="2" Margin="0,10,0,0"><TextBlock x:Name="FooterStatus" Text="提示：拖拽文档到窗口即可添加" Foreground="#9AA4B9" FontSize="10" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/><TextBlock Text="文页 PDF  /  v1.0" HorizontalAlignment="Right" Foreground="#A4ADBF" FontSize="10"/></Grid>
  </Grid>
 </Grid>
</Window>
